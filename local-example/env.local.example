#!/usr/bin/env zsh
# Machine-specific environment variables
# This file is NOT tracked in git
# Copy to ~/.dotfiles/zsh/env.local.zsh and customize

# ============================================================================
# Language-Specific Paths (Machine-Dependent)
# ============================================================================

# Example: Node.js version manager for this machine
# export NVM_DIR="$HOME/.nvm"
# [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" --no-use

# Example: Python virtual environment location
# export WORKON_HOME="$HOME/.virtualenvs"
# export PROJECT_HOME="$HOME/dev/src"

# Example: Go workspace for this machine
# export GOPATH="$HOME/go-work"

# ============================================================================
# Development Database Connections (Local)
# ============================================================================

# Example: Local database URLs
# export DATABASE_URL="postgresql://localhost/myapp_development"
# export REDIS_URL="redis://localhost:6379"

# ============================================================================
# Machine-Specific Tool Paths
# ============================================================================

# Example: Custom compiler or toolchain
# export CC="/usr/local/bin/gcc-13"
# export CXX="/usr/local/bin/g++-13"

# Example: Android development (if on this machine)
# export ANDROID_HOME="$HOME/Android/Sdk"
# export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools"

# ============================================================================
# Performance Tuning
# ============================================================================

# Example: Adjust history size for machines with more RAM
# export HISTSIZE=100000
# export SAVEHIST=100000

# Example: Parallel make jobs based on CPU cores
# export MAKEFLAGS="-j$(nproc)"

# ============================================================================
# Apollo Prompt Colors
# ============================================================================
# ANSI color names and 256-color indexes both work. These are the defaults.

# zstyle ':dotfiles:prompt:apollo:context'     background 240
# zstyle ':dotfiles:prompt:apollo:context'     foreground white
# zstyle ':dotfiles:prompt:apollo:directory'   background blue
# zstyle ':dotfiles:prompt:apollo:directory'   foreground black
# zstyle ':dotfiles:prompt:apollo:git-clean'   background green
# zstyle ':dotfiles:prompt:apollo:git-clean'   foreground black
# zstyle ':dotfiles:prompt:apollo:git-dirty'   background yellow
# zstyle ':dotfiles:prompt:apollo:git-dirty'   foreground black
# zstyle ':dotfiles:prompt:apollo:environment' background magenta
# zstyle ':dotfiles:prompt:apollo:environment' foreground black
# zstyle ':dotfiles:prompt:apollo:duration'    background yellow
# zstyle ':dotfiles:prompt:apollo:duration'    foreground black
# zstyle ':dotfiles:prompt:apollo:error'       background red
# zstyle ':dotfiles:prompt:apollo:error'       foreground black
# zstyle ':dotfiles:prompt:apollo:jobs'        background cyan
# zstyle ':dotfiles:prompt:apollo:jobs'        foreground black
# zstyle ':dotfiles:prompt:apollo:clock'       background 240
# zstyle ':dotfiles:prompt:apollo:clock'       foreground white

# Any segment can be hidden:
# zstyle ':dotfiles:prompt:apollo:clock' enabled no
